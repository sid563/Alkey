# Server
HOST=127.0.0.1
PORT=8080

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taskdb

# Redis (matches docker-compose.yml)
REDIS_URL=redis://127.0.0.1:6379

# JWT - use a long random string in real deployments
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL_HOURS=24

# 2FA
TWOFA_TTL_MINUTES=5

# Cache
CACHE_TTL_SECONDS=60

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Optional real email delivery via SMTP (leave blank to use email_logs/console only).
# For Gmail, SMTP_PASSWORD is an App Password (Google Account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Dev convenience: seeded users have fake addresses, so redirect ALL outgoing
# mail to one real inbox you own.
SMTP_DEV_REDIRECT_TO=
